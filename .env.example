# Neon Database Configuration
# Copy this file to .env.dev (gitignored) and fill in your actual values. NEVER commit real values.
DATABASE_URL=jdbc:postgresql://your-neon-host/arenaflow?sslmode=require
DATABASE_USERNAME=your-username
DATABASE_PASSWORD=your-password

# JWT (ADR-0001): base64, >=256 bit. Tao bang: openssl rand -base64 32
JWT_SECRET=<your-base64-secret>

# Cloudinary: moi moi truong dung root folder rieng (vd arenaflow-dev, arenaflow-prod).
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
CLOUDINARY_FOLDER=<environment-specific-root-folder>

# API docs (ADR-0004): mac dinh tat. Chi bo comment dong duoi o may dev; KHONG dat o moi truong deploy.
# SPRINGDOC_ENABLED=true

# Job vòng đời kèo: biểu thức cron 6 trường (giây phút giờ ngày tháng thứ), tự cấu hình theo môi trường;
# mặc định mỗi 5 phút (0 */5 * * * *), đặt "-" để tắt job.
# MATCH_LIFECYCLE_CRON=0 */5 * * * *

# Kênh realtime STOMP (/ws): danh sách mẫu URL origin của FE được phép kết nối, phân cách bằng dấu phẩy
# (lấy từ domain triển khai FE của môi trường tương ứng). Mặc định để trống = chỉ cho phép same-origin; không bao giờ đặt "*".
# WS_ALLOWED_ORIGIN_PATTERNS=https://your-fe-domain
