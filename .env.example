# Neon Database Configuration
# Copy this file to .env.dev (gitignored) and fill in your actual values. NEVER commit real values.
DATABASE_URL=jdbc:postgresql://your-neon-host/arenaflow?sslmode=require
DATABASE_USERNAME=your-username
DATABASE_PASSWORD=your-password

# JWT (ADR-0001): base64, >=256 bit. Tao bang: openssl rand -base64 32
JWT_SECRET=<your-base64-secret>

# API docs (ADR-0004): mac dinh tat. Chi bo comment dong duoi o may dev; KHONG dat o moi truong deploy.
# SPRINGDOC_ENABLED=true
