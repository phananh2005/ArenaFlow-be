// ArenaFlow Database Schema
// Generated from V1__initial_schema.sql — bảng team, team_member cập nhật tới V4 (USER-002); match, match_venue_option,
// match_time_option, cost_custom_item, pairing cập nhật tới V8 (MATCH-002); phần còn lại theo migration ghi ở note
// Cột thời gian: timestamp (không múi giờ) giờ Việt Nam theo V6 (SYSTEM-002); DEFAULT now() AT TIME ZONE 'Asia/Ho_Chi_Minh'
// Use at: https://dbdiagram.io

Project ArenaFlow {
  database_type: 'PostgreSQL'
  Note: 'ArenaFlow - Nền tảng kết nối đội bóng'
}

// ================================================================
// 1. User & Authentication
// ================================================================

Table administrative_unit {
  id uuid [pk]
  name varchar(100) [not null]
  level varchar(20) [not null, note: 'province, district, ward']
  parent_id uuid [ref: > administrative_unit.id]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    parent_id
    level
  }
}

Table user {
  id uuid [pk]
  display_name varchar(100) [not null]
  avatar_url varchar(500)
  bio text
  preferred_position varchar(50)
  date_of_birth date
  gender varchar(20)
  district_id uuid [ref: > administrative_unit.id]
  phone_number varchar(20)
  reliability_score integer [not null, default: 80, note: '0-100']
  total_matches_completed integer [not null, default: 0]
  total_matches_confirmed integer [not null, default: 0]
  average_rating decimal(3,2) [note: '1.0-5.0']
  report_count_noshow integer [not null, default: 0]
  report_count_bad_play integer [not null, default: 0]
  report_count_bad_communication integer [not null, default: 0]
  report_count_skill_mismatch integer [not null, default: 0]
  clean_streak integer [not null, default: 0]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  updated_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  deleted_at timestamp

  indexes {
    (phone_number) [unique, note: 'WHERE deleted_at IS NULL']
    district_id
    deleted_at
  }
}

Table oauth_account {
  id uuid [pk]
  user_id uuid [not null, ref: > user.id]
  provider varchar(50) [not null, note: 'google, facebook, phone']
  provider_user_id varchar(255) [not null]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (provider, provider_user_id) [unique]
    user_id
  }
}

// ================================================================
// 2. Team
// ================================================================

Table team {
  id uuid [pk]
  name varchar(100) [not null]
  created_by uuid [not null, ref: > user.id]
  avatar_url varchar(500)
  description text
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, INACTIVE, DISBANDED (V4)']
  skill_levels text [not null, default: '[]', note: 'JSON array nhãn (V2)']
  inactive_reason varchar(500) [note: 'Lý do admin khoá (V2); giữ nguyên khi giải tán']
  disband_reason varchar(100) [note: 'V4; NOT NULL khi DISBANDED']
  disbanded_at timestamp [note: 'V4; NOT NULL khi DISBANDED']
  disbanded_by uuid [ref: > user.id, note: 'V4; NOT NULL khi DISBANDED; ON DELETE RESTRICT']
  version bigint [not null, default: 0, note: 'Optimistic lock (V2)']
  reliability_score integer [not null, default: 80, note: '0-100']
  total_matches_completed integer [not null, default: 0]
  total_matches_confirmed integer [not null, default: 0]
  average_rating decimal(3,2) [note: '1.0-5.0']
  report_count_noshow integer [not null, default: 0]
  report_count_bad_play integer [not null, default: 0]
  report_count_bad_communication integer [not null, default: 0]
  report_count_skill_mismatch integer [not null, default: 0]
  clean_streak integer [not null, default: 0]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  updated_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  Note: 'CHECK team_disband_consistency_check: DISBANDED ⇔ disband_reason, disbanded_at, disbanded_by đều NOT NULL (V4)'

  indexes {
    created_by
    (status, created_at) [note: 'idx_team_status_created: status, created_at DESC (V2, thay idx_team_status)']
    disbanded_by [name: 'idx_team_disbanded_by', note: 'V7; WHERE disbanded_by IS NOT NULL']
  }
}

Table team_member {
  id uuid [pk]
  team_id uuid [not null, ref: > team.id]
  user_id uuid [not null, ref: > user.id]
  role varchar(20) [not null, note: 'CAPTAIN, MEMBER']
  status varchar(20) [not null, note: 'PENDING, ACTIVE, LEFT, REJECTED (V2)']
  invited_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  joined_at timestamp
  left_at timestamp
  version bigint [not null, default: 0, note: 'Optimistic lock (V2)']

  indexes {
    (team_id, user_id) [unique, note: 'idx_team_member_pending_or_active WHERE status IN (PENDING, ACTIVE) (V2)']
    (team_id, role, status)
    (user_id, status)
  }
}

Table team_tag {
  id uuid [pk]
  team_id uuid [not null, ref: > team.id]
  tag varchar(50) [not null, note: 'Chill, Nhiệt tình, Máu lửa, etc.']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (team_id, tag) [unique]
    team_id
  }
}

Table team_captain_history {
  id uuid [pk]
  team_id uuid [not null, ref: > team.id]
  from_user_id uuid [ref: > user.id]
  to_user_id uuid [not null, ref: > user.id]
  transferred_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (team_id, transferred_at)
  }
}

// ================================================================
// 3. Sport
// ================================================================

Table sport {
  id uuid [pk]
  name varchar(50) [not null, unique]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  Note: 'Initial data: Bóng đá'
}

// ================================================================
// 4. Venue
// ================================================================

Table venue {
  id uuid [pk]
  name varchar(200) [not null]
  address text [not null]
  latitude decimal(10,7) [not null]
  longitude decimal(10,7) [not null]
  created_by_type varchar(20) [not null, note: 'ADMIN, USER']
  created_by_user_id uuid [ref: > user.id, note: 'ON DELETE RESTRICT (V5); NOT NULL khi created_by_type = USER']
  ward_id uuid [ref: > administrative_unit.id, note: 'V5; phường/xã (BR-V11); NULL chỉ cho địa điểm cũ — service bắt buộc khi thêm/sửa']
  phone varchar(20)
  website varchar(500)
  venue_type varchar(50) [note: 'FIVE_A_SIDE, SEVEN_A_SIDE, ELEVEN_A_SIDE (CHECK V5)']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, INACTIVE; CHECK: INACTIVE ⇔ admin_verified_inactive_at NOT NULL (V5)']
  last_selected_at timestamp
  admin_verified_inactive_at timestamp
  version bigint [not null, default: 0, note: 'V5; @Version + khoá dòng khi ghi ảnh']
  stale_alerted_at timestamp [note: 'V5; cổng cảnh báo 180 ngày (reset khi được chọn / kích hoạt lại)']
  closure_alerted_at timestamp [note: 'V5; cổng cảnh báo report CLOSED (mở lại khi hết report CLOSED PENDING)']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  updated_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (latitude, longitude, status) [note: 'WHERE status = ACTIVE']
    (status, last_selected_at)
    (status, name, id) [name: 'idx_venue_status_name', note: 'V5']
    ward_id [name: 'idx_venue_ward', note: 'V5']
    created_by_user_id
  }
}

Table venue_image {
  id uuid [pk]
  venue_id uuid [not null, ref: > venue.id]
  image_url varchar(500) [not null]
  public_id varchar(255) [not null, unique, note: 'V5; Cloudinary public ID (uq_venue_image_public_id); dòng cũ = legacy/<id>. Hard-delete (2.13)']
  is_primary boolean [not null, default: false]
  display_order integer [not null, note: '> 0']
  uploaded_by uuid [ref: > user.id]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (venue_id, is_primary) [unique, note: 'WHERE is_primary = TRUE']
    (venue_id, display_order)
  }
}

Table venue_report {
  id uuid [pk]
  venue_id uuid [not null, ref: > venue.id]
  reporter_id uuid [not null, ref: > user.id, note: 'ON DELETE RESTRICT (V5)']
  reason varchar(20) [not null, note: 'CLOSED, WRONG_INFO, OTHER (V5: TEXT → VARCHAR(20), mô tả cũ chuyển sang detail)']
  detail text [note: 'V5']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, VERIFIED, REJECTED (V5)']
  handled_by uuid [ref: > user.id, note: 'V5; ON DELETE RESTRICT; CHECK: NULL ⇔ status = PENDING']
  handled_at timestamp [note: 'V5; CHECK: NULL ⇔ status = PENDING']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (venue_id, created_at)
    reporter_id
    (status, created_at) [name: 'idx_venue_report_status_created', note: 'V5; created_at DESC']
    (reporter_id, venue_id, reason) [unique, name: 'uq_venue_report_pending', note: 'V5; WHERE status = PENDING']
  }
}

// ================================================================
// 5. Match & Pairing
// ================================================================

Table match {
  id uuid [pk]
  type varchar(20) [not null, note: 'HAS_VENUE, NEED_VENUE']
  author_team_id uuid [not null, ref: > team.id]
  status varchar(20) [not null, default: 'OPEN', note: 'OPEN, CONFIRMED, ARCHIVED, COMPLETED, EXPIRED, CANCELLED']
  sport_id uuid [not null, ref: > sport.id]
  format varchar(20) [note: 'V7: VARCHAR(10) -> VARCHAR(20); FIVE_A_SIDE, SEVEN_A_SIDE, ELEVEN_A_SIDE; NOT NULL khi type = HAS_VENUE']
  skill_levels text [not null, default: '[]', note: 'V7; JSON array nhãn trình độ']
  age_note text
  match_nature text
  venue_id uuid [ref: > venue.id, note: 'HAS_VENUE: bắt buộc; NEED_VENUE: null khi chưa ghép, = địa điểm đã chốt khi ghép (V8 match_type_venue_check)']
  match_start_time timestamp [not null, note: 'NEED_VENUE chưa ghép: khung giờ sớm nhất; khi ghép: khung đã chốt']
  match_end_time timestamp [not null]
  expires_at timestamp [not null]
  search_lat decimal(10,7) [note: 'Không dùng (V8 bỏ idx_match_search_gps; kèo B tìm theo lựa chọn địa điểm)']
  search_lng decimal(10,7) [note: 'Không dùng']
  search_radius_km decimal(5,2) [note: 'Không dùng']
  cost_type varchar(50) [note: 'V7 CHECK: VENUE_ONLY, DRINKS_ONLY, BOTH']
  cost_split varchar(50) [note: 'V7 CHECK: FIFTY_FIFTY, SEVENTY_THIRTY_HOME, SEVENTY_THIRTY_LOSER, LOSER_PAYS_DRINKS']
  cost_venue_amount bigint [note: 'V7 CHECK: > 0']
  cost_drinks_amount bigint [note: 'V7 CHECK: > 0']
  cost_deposit_amount bigint [note: 'V8; tiền cọc đã chốt, chỉ NEED_VENUE; CHECK > 0']
  cost_deposit_holder varchar(100) [note: 'V8 CHECK: chỉ có khi có cost_deposit_amount']
  confirmed_opponent_team_id uuid [ref: > team.id]
  cancelled_by_team_id uuid [ref: > team.id]
  cancelled_at timestamp
  cancel_reason varchar(500) [note: 'V7; lý do huỷ kèo']
  version bigint [not null, default: 0, note: 'V7; @Version optimistic lock']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  updated_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (author_team_id, status)
    (confirmed_opponent_team_id, status) [name: 'idx_match_opponent_status', note: 'V7']
    (status, expires_at)
    (status, match_end_time)
    (sport_id, status, match_start_time)
    (match_start_time, id) [name: 'idx_match_open_start', note: 'V7; WHERE status = OPEN']
  }

  Note: 'V8 bỏ confirmed_venue_id, confirmed_match_time (kèo B ghi thẳng venue_id, match_start_time/match_end_time, chi phí + cọc khi ghép); CHECK match_type_venue_check, match_deposit_check'
}

Table match_venue_option {
  id uuid [pk]
  match_id uuid [not null, ref: > match.id]
  venue_id uuid [not null, ref: > venue.id]
  display_order integer [not null, note: 'V8; thứ tự nhập 1..5']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (match_id, venue_id) [unique, name: 'match_venue_option_match_venue_key', note: 'V8; đích FK phương án của pairing']
    (match_id, display_order) [unique, name: 'match_venue_option_match_order_key', note: 'V8']
    venue_id [name: 'idx_match_venue_option_venue', note: 'V8; thay idx_match_venue_option_match']
  }
}

Table match_time_option {
  id uuid [pk]
  match_id uuid [not null, ref: > match.id]
  proposed_start_time timestamp [not null]
  proposed_end_time timestamp [not null, note: 'V8 CHECK: > proposed_start_time']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (match_id, id) [unique, name: 'match_time_option_match_id_key', note: 'V8; đích FK phương án của pairing']
    (match_id, proposed_start_time) [unique, name: 'match_time_option_match_start_key', note: 'V8; thay idx_match_time_option_match']
  }
}

Table cost_custom_item {
  id uuid [pk]
  match_id uuid [ref: > match.id, note: 'V8: bỏ NOT NULL; khoản của kèo (luồng A, hoặc chép từ pairing khi ghép kèo B)']
  pairing_id uuid [note: 'V8; khoản của thương lượng (luồng B); FK ON DELETE CASCADE']
  item_name varchar(100) [not null]
  amount bigint [not null, note: 'V7 CHECK: > 0']
  display_order integer [not null, note: 'V7; > 0']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (match_id, display_order) [unique, name: 'idx_cost_custom_item_order', note: 'V7; thay idx_cost_custom_item_match']
    (pairing_id, display_order) [unique, name: 'idx_cost_custom_item_pairing_order', note: 'V8']
  }

  Note: 'V8 CHECK cost_custom_item_owner_check: đúng một trong match_id, pairing_id khác null'
}

Ref: cost_custom_item.pairing_id > pairing.id [delete: cascade]

Table match_request {
  id uuid [pk]
  match_id uuid [not null, ref: > match.id]
  requester_team_id uuid [not null, ref: > team.id]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, ACCEPTED, REJECTED, WITHDRAWN, SUPERSEDED, EXPIRED']
  reason varchar(500) [note: 'V7; lý do từ chối hoặc rút yêu cầu']
  requested_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  responded_at timestamp
  withdrawn_at timestamp

  indexes {
    (match_id, requester_team_id) [unique, note: 'WHERE status NOT IN (WITHDRAWN, EXPIRED)']
    match_id [unique, name: 'idx_match_request_accepted', note: 'V7; WHERE status = ACCEPTED']
    (match_id, status)
    (requester_team_id, status)
  }
}

Table pairing {
  id uuid [pk]
  match_id uuid [not null, ref: > match.id]
  interested_team_id uuid [not null, ref: > team.id]
  status varchar(20) [not null, default: 'NEGOTIATING', note: 'NEGOTIATING, CONFIRMED, EXPIRED, SUPERSEDED']
  revision integer [not null, default: 0, note: 'V8; tăng mỗi lần sửa gói (phương án / chi phí); CHECK >= 0']
  proposed_venue_id uuid [note: 'V8; phương án đã chốt — cùng cặp với proposed_time_option_id']
  proposed_time_option_id uuid [note: 'V8']
  cost_type varchar(50) [note: 'V8 CHECK: VENUE_ONLY, DRINKS_ONLY, BOTH']
  cost_split varchar(50) [note: 'V8 CHECK: FIFTY_FIFTY, SEVENTY_THIRTY_HOME, SEVENTY_THIRTY_LOSER, LOSER_PAYS_DRINKS']
  cost_venue_amount bigint [note: 'V8 CHECK: > 0']
  cost_drinks_amount bigint [note: 'V8 CHECK: > 0']
  cost_deposit_amount bigint [note: 'V8 CHECK: > 0']
  cost_deposit_holder varchar(100) [note: 'V8 CHECK: chỉ có khi có cost_deposit_amount']
  author_confirmed_at timestamp
  interested_confirmed_at timestamp
  final_confirmed_at timestamp
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  updated_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`, note: 'V8']

  indexes {
    (match_id, interested_team_id) [unique, note: 'WHERE status NOT IN (EXPIRED, SUPERSEDED)']
    (match_id, status)
    (interested_team_id, status)
    match_id [unique, name: 'idx_pairing_confirmed', note: 'V8; WHERE status = CONFIRMED — tối đa một pairing CONFIRMED mỗi kèo (thay idx_pairing_race)']
  }

  Note: 'V8 CHECK: pairing_proposal_pair_check (phương án đủ cặp hoặc cùng null), pairing_confirmed_proposal_check (CONFIRMED phải có phương án), pairing_cost_*_check'
}

Ref pairing_proposed_venue: pairing.(match_id, proposed_venue_id) > match_venue_option.(match_id, venue_id)
Ref pairing_proposed_time: pairing.(match_id, proposed_time_option_id) > match_time_option.(match_id, id)

// ================================================================
// 6. Rating & Report
// ================================================================

Table rating {
  id uuid [pk]
  match_id uuid [not null, ref: > match.id]
  rater_type varchar(20) [not null, note: 'TEAM, INDIVIDUAL']
  rater_id uuid [not null, note: 'FK to team or user']
  ratee_type varchar(20) [not null, note: 'TEAM, INDIVIDUAL']
  ratee_id uuid [not null, note: 'FK to team or user']
  score decimal(2,1) [not null, note: '1.0-5.0']
  comment text
  match_score_home integer
  match_score_away integer
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (match_id, rater_type, rater_id, ratee_type, ratee_id) [unique]
    (ratee_type, ratee_id)
  }
}

Table report {
  id uuid [pk]
  match_id uuid [not null, ref: > match.id]
  reporter_type varchar(20) [not null, note: 'TEAM, INDIVIDUAL']
  reporter_id uuid [not null, note: 'FK to team or user']
  reported_type varchar(20) [not null, note: 'TEAM, INDIVIDUAL']
  reported_id uuid [not null, note: 'FK to team or user']
  report_type varchar(50) [not null, note: 'NOSHOW, BAD_PLAY, BAD_COMMUNICATION, SKILL_MISMATCH']
  reason text
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, CONFIRMED, REJECTED']
  admin_reviewed_at timestamp
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    match_id
    (reported_type, reported_id, report_type)
    (status, created_at)
  }
}

// ================================================================
// 7. Mercenary
// ================================================================

Table mercenary_recruitment {
  id uuid [pk]
  match_id uuid [not null, ref: > match.id]
  team_id uuid [not null, ref: > team.id]
  position varchar(50) [not null, note: 'Thủ môn, Hậu vệ, Tiền vệ, Tiền đạo']
  quantity_needed integer [not null, note: '> 0']
  quantity_approved integer [not null, default: 0]
  status varchar(20) [not null, default: 'OPEN', note: 'OPEN, FILLED, EXPIRED, CLOSED']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  updated_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    match_id
    (team_id, status)
    (status, position)
  }
}

Table mercenary_application {
  id uuid [pk]
  recruitment_id uuid [not null, ref: > mercenary_recruitment.id]
  applicant_id uuid [not null, ref: > user.id]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, APPROVED, REJECTED, WITHDRAWN']
  applied_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]
  responded_at timestamp
  withdrawn_at timestamp

  indexes {
    (recruitment_id, applicant_id) [unique, note: 'WHERE status NOT IN (WITHDRAWN, REJECTED)']
    (recruitment_id, status)
    (applicant_id, status)
  }
}

// ================================================================
// 8. Chat & Notification
// ================================================================

Table conversation {
  id uuid [pk]
  context_type varchar(30) [not null, note: 'V7: TEAM_MATCH (V10 thêm MERCENARY_APPLICATION)']
  match_id uuid [ref: > match.id, note: 'ON DELETE RESTRICT; NOT NULL khi context_type = TEAM_MATCH']
  party_a_type varchar(10) [not null, note: 'TEAM, USER']
  party_a_id uuid [not null, note: 'Đội tạo kèo (TEAM_MATCH)']
  party_b_type varchar(10) [not null, note: 'TEAM, USER']
  party_b_id uuid [not null, note: 'Đội tham gia (TEAM_MATCH) hoặc ứng viên']
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  Note: 'V7 (thay chat_message của V1). CHECK conversation_parties_check: hai bên không trùng nhau'

  indexes {
    (match_id, party_b_id) [unique, name: 'idx_conversation_team_match', note: 'V7; WHERE context_type = TEAM_MATCH']
    party_a_id [name: 'idx_conversation_party_a', note: 'V7']
    party_b_id [name: 'idx_conversation_party_b', note: 'V7']
  }
}

Table conversation_message {
  id uuid [pk]
  conversation_id uuid [not null, ref: > conversation.id, note: 'ON DELETE CASCADE']
  sender_party varchar(1) [not null, note: 'A, B']
  sender_user_id uuid [not null, ref: > user.id, note: 'ON DELETE RESTRICT']
  message text [not null, note: 'char_length 1..1000']
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (conversation_id, created_at, id) [name: 'idx_conversation_message_time', note: 'V7']
    (conversation_id, sender_party) [name: 'idx_conversation_message_unread', note: 'V7; WHERE NOT is_read']
  }
}

Table notification {
  id uuid [pk]
  recipient_user_id uuid [not null, ref: > user.id]
  type varchar(50) [not null, note: 'MATCH_REQUEST_RECEIVED, REQUEST_ACCEPTED, etc.']
  title varchar(200) [not null]
  body text [not null]
  reference_type varchar(50)
  reference_id uuid
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now() AT TIME ZONE 'Asia/Ho_Chi_Minh'`]

  indexes {
    (recipient_user_id, is_read, created_at)
    created_at [note: 'For retention cleanup']
  }
}
