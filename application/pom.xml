<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.phananh</groupId>
		<artifactId>ArenaFlow</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>application</artifactId>
	<packaging>jar</packaging>
	<name>application</name>
	<description>Application layer: service, use case, DTO, MapStruct mapper, validation</description>

	<dependencies>
		<dependency>
			<groupId>com.phananh</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.phananh</groupId>
			<artifactId>domain</artifactId>
		</dependency>

		<!-- Không kéo web/security vào tầng service: HTTP & Spring Security chỉ ở module api.
		     Spring context, transaction, Spring Data, Jackson đến từ domain (starter-data-jpa, jackson-databind). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<!-- JwtTokenService ký/xác minh JWT bằng Nimbus JOSE. Lấy qua spring-security-oauth2-jose
			     (Boot BOM quản lý) để Nimbus cùng version với resource server ở module api; không kéo web. -->
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
